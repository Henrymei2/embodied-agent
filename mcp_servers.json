{
    "mcp_servers": {
      "bash": {
        "command": "uv",
        "args": ["run", "python", "mcp_servers/bash_tools.py"]
      },
      "scene": {
        "command": "uv",
        "args": ["run", "python", "mcp_servers/scene_tools.py"]
      },
      "screen": {
        "command": "uv",
        "args": ["run", "python", "mcp_servers/screen_tools.py"]
      },
      "calendar": {
        "command": "uv",
        "args": ["run", "python", "mcp_servers/calendar_tools.py"]
      },
      "scheduler": {
        "command": "uv",
        "args": ["run", "python", "mcp_servers/scheduler.py"]
      },
      "todo": {
        "command": "uv",
        "args": ["run", "python", "mcp_servers/todo_tools.py"]
      },
      "timer": {
        "command": "uv",
        "args": ["run", "python", "mcp_servers/timer_tools.py"]
      },
      "weather": {
        "command": "uv",
        "args": ["run", "python", "mcp_servers/weather_tools.py"]
      },
      "library": {
        "command": "uv",
        "args": ["run", "python", "mcp_servers/library_tools.py"]
      },
      "plan": {
        "command": "uv",
        "args": ["run", "python", "mcp_servers/plan_tools.py"]
      },
      "idle": {
        "command": "uv",
        "args": ["run", "python", "mcp_servers/idle_tools.py"]
      },
      "drive": {
        "command": "uv",
        "args": ["run", "python", "mcp_servers/drive_tools.py"]
      },
      "gmail": {
        "command": "uv",
        "args": ["run", "python", "mcp_servers/gmail_tools.py"]
      },
      "playwright": {
        "command": "npx",
        "args": [
          "-y",
          "@playwright/mcp@latest",
          "--browser=chrome",
          "--viewport-size=1280x720"
        ]
      },
      "time": {
        "command": "uvx",
        "args": ["mcp-server-time"]
      },
      "ddg-search": {
        "command": "uvx",
        "args": ["duckduckgo-mcp-server"]
      }
    }
}
